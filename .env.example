# ============= VITE REACT FRONTEND CONFIG =============
# These variables must start with VITE_ to be exposed to the browser

# API Server URL (for backend calls)
# Development: http://localhost:5000/api
# Production: https://your-api.hostpinnacle.com/api
VITE_API_URL=http://localhost:5000/api

# Strapi CMS URL
# Development: http://localhost:1337
# Production: https://your-strapi-instance.com
VITE_STRAPI_URL=http://localhost:1337

# Environment
VITE_ENV=development
