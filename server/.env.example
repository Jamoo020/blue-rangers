# ============= DARAJA M-PESA CREDENTIALS =============
# Get these from https://developer.safaricom.co.ke
CONSUMER_KEY=your_consumer_key_here
CONSUMER_SECRET=your_consumer_secret_here
PASSKEY=your_passkey_here
SHORTCODE=174379
INITIATOR_PASSWORD=your_initiator_password_here

# M-Pesa Endpoint (sandbox or production)
MPESA_ENDPOINT=https://sandbox.safaricom.co.ke
# For production: https://api.safaricom.co.ke

# Callback URL where M-Pesa sends payment responses
CALLBACK_URL=http://localhost:5000/api/payment/callback
# In production, update to: https://your-hostpinnacle-domain.com/api/payment/callback

# ============= SERVER CONFIGURATION =============
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# For production: https://your-domain.com,https://www.your-domain.com

# ============= DATABASE CONFIGURATION =============
# Choose: sqlite (default) or postgresql
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/transactions.db

# PostgreSQL (if DATABASE_TYPE=postgresql)
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=football_club_db
# DATABASE_USER=db_user
# DATABASE_PASSWORD=your_secure_password

# ============= SECURITY =============
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=your_secure_api_key_min_32_chars_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============= LOGGING =============
LOG_LEVEL=info
# LOG_FILE_PATH=./logs/server.log

# ============= SECURITY HEADERS =============
ENABLE_HTTPS=true
# For development without HTTPS: ENABLE_HTTPS=false
